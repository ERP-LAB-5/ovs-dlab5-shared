      "id": "pick-prepare",
      "from": "pick",
      "to": "prepare",
      "label": "prepare",
      "variant": "emphasis"
    },
    {
      "id": "prepare-odoo",
      "from": "prepare",
      "to": "odoo",
      "label": "read by ids",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "prepare-validate",
      "from": "prepare",
      "to": "validate",
      "label": "propose plan"
    },
    {
      "id": "validate-approve",
      "from": "validate",
      "to": "approve-apply",
      "label": "counts, SHA",
      "variant": "emphasis"
    },
    {
      "id": "approve-gate",
      "from": "approve-apply",
      "to": "gate",
      "label": "approval recorded",
      "variant": "security"
    },
    {
      "id": "run-gate",
      "from": "run-apply",
      "to": "gate",
      "label": "send step i",
      "variant": "emphasis"
    },
    {
      "id": "gate-shop",
      "from": "gate",
      "to": "shop-draft",
      "label": "contract writes",
      "variant": "emphasis",
      "role": "branch"
    },
    {
      "id": "gate-outcome",
      "from": "gate",
      "to": "prepare-release",
      "label": "outcomes kept"
    },
    {
      "id": "release-approve",
      "from": "prepare-release",
      "to": "approve-release",
      "label": "new plan, SHA",
      "variant": "emphasis"
    },
    {
      "id": "approve-send-release",
      "from": "approve-release",
      "to": "send-release",
      "label": "approval recorded",
      "variant": "security"
    },
    {
      "id": "run-send-release",
      "from": "run-release",
      "to": "send-release",
      "label": "send step i",
      "variant": "emphasis"
    },
    {
      "id": "release-shop",
      "from": "send-release",
      "to": "shop-live",
      "label": "ACTIVE, publish",
      "variant": "emphasis",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Prepare (ADR-0019)",
      "items": [
        "The edge reads the picked products from Odoo, only by ids, never a write: their texts in every language, attributes, tags and prices from a chosen pricelist.",
        "It turns them into a plan of contract writes: setup, colour entries, a productSet per product (always DRAFT), then each product's translations.",
        "ovs-dlab5-edge: extract.py, apply_plan.py, execute.py"
      ]
    },
    {
      "dot": "rose",
      "title": "The gate sends (ADR-0008, ADR-0023)",
      "items": [
        "The cloud checks every step against the write contract, sets forced values, and names the plan by the SHA-256 it computes itself. A person approves those counts and that digest, on the site.",
        "The edge then asks for step i, one at a time. The cloud sends it with the key it holds, only while the approval of that digest stands, and once. There is no --force, and the PC holds no key that could write.",
        "ovs-dlab5-net: functions/execute/handler.ts, execute/plan.ts, runs/policy.ts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Apply, then release",
      "items": [
        "A reference to an entry or a product written earlier in the run (@mo:, @product:) is filled only from the cloud's stored outcome, never from the caller.",
        "A product written in the apply stays DRAFT until a release plan, approved the same way, makes it ACTIVE and puts it on the Online Store; an undo takes it off again.",
        "A product the store already had is left alone unless OVS wrote it or a person handed it over."
      ]
    }
  ]
}
