@prefix ovs:     <http://ovs.dlab5.net/core#> .
@prefix ovssh:   <http://ovs.dlab5.net/shapes#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix schema:  <https://schema.org/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# SHACL shapes: what an A-Box must satisfy. Validate an A-Box TOGETHER with
# tbox/ovs.ttl and tbox/ovs-concepts.ttl, so a step can be checked against its
# scheme. The cloud refuses an A-Box that does not conform (ADR-0007).
#
# This file replaces the D-LAB-5 template placeholder, which validated
# `app:Thing` from `template.dlab5.net`. It is the one of the three that the
# edge copies and enforces locally, so an edge refuses the same A-Box the
# cloud would — scripts/sync-ontology.sh in ovs-dlab5-edge.
#
# The LAYER rules are not here; they are in ovs-layers.ttl and apply to
# ontology documents rather than to assertions.
# ============================================================

# -- an asserted individual ----------------------------------------------------

ovssh:AssertedIndividualShape a sh:NodeShape ;
    sh:targetClass ovs:AssertedIndividual ;

    sh:property [
        sh:path ovs:sourceSystem ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class ovs:System ;
        sh:message "An assertion says which system it was read from. One row, one system: a fused twin is projected, not stored (ADR-0011)."@en ;
    ] ;

    sh:property [
        sh:path ovs:sourceTerm ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An assertion names the model or table it came out of, as a term rather than a string."@en ;
    ] ;

    sh:property [
        sh:path ovs:sourceId ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "An assertion carries the id its source gave it, or it cannot be re-derived — and the A-Box is defined by being re-derivable."@en ;
    ] ;

    # Locale is part of IDENTITY, not an attribute of it (ADR-0007). A
    # trilingual catalogue asserts one product three times with genuinely
    # different literals. At most one value here, because two would mean one
    # node claiming to be two identities.
    #
    # ABSENT means language-independent. ADR-0011 omits `*` rather than
    # asserting it, so the shape must not require this property.
    sh:property [
        sh:path schema:inLanguage ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "At most one locale per assertion: locale is part of identity, so two locales are two individuals. Omit it entirely for a language-independent fact."@en ;
    ] ;

    sh:property [
        sh:path ovs:aligned ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "ovs:aligned is a boolean. False is a legitimate answer — a half twin is a result, not an error."@en ;
    ] ;

    # settings.SINGLE_VALUED in the edge names schema:name as single-valued:
    # two different values from two sides are a CONFLICT a person resolves,
    # not both kept.
    sh:property [
        sh:path schema:name ;
        sh:maxCount 1 ;
        sh:message "A name is single-valued. Two values from two systems is a conflict for a person to resolve, not something to merge silently."@en ;
    ] .

# -- a process step cited by anything must be a step in a scheme ---------------
#
# Validating the A-Box together with tbox/ovs-concepts.ttl is what makes this
# checkable: a citation of a step that no scheme declares is a typo that would
# otherwise sit in the graph looking like data.

ovssh:InAScheme a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:message "A process step belongs to a concept scheme."@en ;
    ] .

ovssh:ProcessStepCitationShape a sh:NodeShape ;
    sh:targetSubjectsOf ovs:processStep ;
    sh:property [
        sh:path ovs:processStep ;
        sh:node ovssh:InAScheme ;
        sh:message "A cited process step must be a concept in a declared scheme. Validate together with tbox/ovs-concepts.ttl."@en ;
    ] .

# ============================================================
# Capabilities in a workspace (ADR-0018): as-is, availability, to-be.
# Checked on every change, so these say what a single statement must be,
# not whether the work is finished: that is shapes/ovs-map-ready.ttl.
# ============================================================

ovssh:RealisationShape a sh:NodeShape ;
    sh:targetClass ovs:Realisation ;
    sh:property [
        sh:path ovs:step ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "A realisation names exactly one step, from a declared scheme."@en ;
    ] ;
    sh:property [
        sh:path ovs:capability ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A realisation names exactly one capability, by its IRI in a capability ontology."@en ;
    ] ;
    sh:property [
        sh:path ovs:evidence ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A realisation says what shows the capability is in use: a finding of a discovery run. Without evidence it is a guess."@en ;
    ] .

ovssh:AvailabilityShape a sh:NodeShape ;
    sh:targetClass ovs:Availability ;
    sh:property [
        sh:path ovs:capability ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An availability names exactly one capability."@en ;
    ] ;
    sh:property [
        sh:path ovs:availableAs ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( ovs:Included ovs:Installed ovs:Licensable ovs:Candidate ) ;
        sh:message "An availability says how the capability is available: included, installed, licensable or a candidate."@en ;
    ] .

ovssh:AllocationShape a sh:NodeShape ;
    sh:targetClass ovs:Allocation ;
    sh:property [
        sh:path ovs:step ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "An allocation names exactly one step, from a declared scheme."@en ;
    ] ;
    sh:property [
        sh:path ovs:side ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( ovs:Source ovs:Target ovs:Both ) ;
        sh:message "An allocation names exactly one side: ovs:Source, ovs:Target or ovs:Both."@en ;
    ] ;
    sh:property [
        sh:path ovs:capability ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An allocation names the capabilities that will implement the step."@en ;
    ] ;
    sh:property [
        sh:path ovs:decision ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An allocation cites at most one decision, by IRI (urn:ovs:decision:<id>)."@en ;
    ] ;
    sh:property [
        sh:path ovs:chosenOption ; sh:maxCount 1 ;
        sh:message "An allocation records at most one chosen option."@en ;
    ] .

# Both => a decision. Written as the implication it is: "not Both, or decided".
# Source and Target MAY cite a decision too, and usually do: the commonest way
# to resolve an overlap is to give the step to one side.
ovssh:OverlapIsDecidedShape a sh:NodeShape ;
    sh:targetClass ovs:Allocation ;
    sh:or (
        [ sh:not [ sh:property [ sh:path ovs:side ; sh:hasValue ovs:Both ] ] ]
        [ sh:property [ sh:path ovs:decision ; sh:minCount 1 ] ;
          sh:property [ sh:path ovs:chosenOption ; sh:minCount 1 ] ]
    ) ;
    sh:message "An allocation to both sides is an overlap, resolved by a person: it names the decision (ovs:decision) and the option chosen (ovs:chosenOption)."@en .

# A decision and its option go together, on any side: half a record is neither.
ovssh:DecisionHasOptionShape a sh:NodeShape ;
    sh:targetClass ovs:Allocation ;
    sh:or (
        [ sh:property [ sh:path ovs:decision ; sh:minCount 1 ] ;
          sh:property [ sh:path ovs:chosenOption ; sh:minCount 1 ] ]
        [ sh:property [ sh:path ovs:decision ; sh:maxCount 0 ] ;
          sh:property [ sh:path ovs:chosenOption ; sh:maxCount 0 ] ]
    ) ;
    sh:message "A decision and the option chosen are recorded together (ovs:decision with ovs:chosenOption), whichever side the step went to."@en .

# -- a mapping (ADR-0018, Map) ------------------------------------------------------

ovssh:MappingShape a sh:NodeShape ;
    sh:targetClass ovs:Mapping ;
    sh:property [
        sh:path ovs:step ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "A mapping is made for exactly one step, from a declared scheme."@en ;
    ] ;
    sh:property [
        sh:path ovs:subjectTerm ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A mapping names exactly one source term, by its IRI."@en ;
    ] ;
    sh:property [
        sh:path ovs:objectTerm ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A mapping names exactly one target term, by its IRI."@en ;
    ] ;
    sh:property [
        sh:path ovs:mappingPredicate ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "propertyMapping" "subClassOf" "equivalentClass" "sameAs" "disjointWith" ) ;
        sh:message "A mapping's predicate is one of the cloud's MappingAxiom predicates: propertyMapping, subClassOf, equivalentClass, sameAs, disjointWith."@en ;
    ] ;
    sh:property [
        sh:path ovs:transform ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z][A-Za-z0-9]*$" ;
        sh:message "A transform is the name of one function, not an expression."@en ;
    ] ;
    sh:property [
        sh:path ovs:valueMap ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A mapping has at most one value map, as a JSON string."@en ;
    ] ;
    sh:property [
        sh:path ovs:perLocale ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "Per locale is true or false, once."@en ;
    ] ;
    sh:property [
        sh:path ovs:direction ; sh:maxCount 1 ; sh:in ( ovs:SourceToTarget ovs:TargetToSource ovs:BothWays ) ;
        sh:message "A mapping flows one way: ovs:SourceToTarget (the default), ovs:TargetToSource or ovs:BothWays."@en ;
    ] .

# ============================================================
# How documents travel (ADR-0021): handovers, journeys, exceptions, carriers.
# The process layer's catalogue is checked by these too (the TBox must
# satisfy the A-Box shapes), so a curated handover is held to the same rules
# as one a workspace adds.
# ============================================================

ovssh:HandoverShape a sh:NodeShape ;
    sh:targetClass ovs:Handover ;
    sh:property [
        sh:path ovs:fromDocument ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A handover leads from exactly one document."@en ;
    ] ;
    sh:property [
        sh:path ovs:toDocument ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A handover leads to exactly one document."@en ;
    ] ;
    sh:property [
        sh:path ovs:atStep ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "A handover happens at exactly one step, from a declared scheme."@en ;
    ] .

ovssh:JourneyShape a sh:NodeShape ;
    sh:targetClass ovs:Journey ;
    sh:property [
        sh:path ovs:startsWith ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A journey starts with exactly one document."@en ;
    ] ;
    sh:property [
        sh:path ovs:endsWith ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A journey ends with exactly one document."@en ;
    ] .

ovssh:ExceptionShape a sh:NodeShape ;
    sh:targetClass ovs:Exception ;
    sh:property [
        sh:path ovs:exceptionAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "An exception happens at exactly one step, from a declared scheme."@en ;
    ] ;
    sh:property [
        sh:path ovs:exceptionOf ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An exception befalls at most one document."@en ;
    ] ;
    sh:property [
        sh:path ovs:outcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( ovs:Ends ovs:Rejoins ovs:LeadsTo ) ;
        sh:message "An exception ends there (ovs:Ends), rejoins the happy path (ovs:Rejoins) or leads to another document (ovs:LeadsTo)."@en ;
    ] ;
    sh:property [
        sh:path ovs:severity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( ovs:Buffer ovs:Smoke ovs:Fire ) ;
        sh:message "An exception says how a map marks it: ovs:Buffer, ovs:Smoke or ovs:Fire."@en ;
    ] ;
    sh:property [
        sh:path ovs:rejoinsAt ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "An exception rejoins at most at one step, from a declared scheme."@en ;
    ] ;
    sh:property [
        sh:path ovs:leadsTo ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An exception leads to at most one document."@en ;
    ] .

# An exception that rejoins says where; one that leads on says to what.
ovssh:RejoinsSomewhereShape a sh:NodeShape ;
    sh:targetSubjectsOf ovs:outcome ;
    sh:or (
        [ sh:path ovs:outcome ; sh:in ( ovs:Ends ) ]
        [ sh:and ( [ sh:path ovs:outcome ; sh:in ( ovs:Rejoins ) ] [ sh:path ovs:rejoinsAt ; sh:minCount 1 ] ) ]
        [ sh:and ( [ sh:path ovs:outcome ; sh:in ( ovs:LeadsTo ) ] [ sh:path ovs:leadsTo ; sh:minCount 1 ] ) ]
    ) ;
    sh:message "An exception that rejoins names where (ovs:rejoinsAt); one that leads on names the document (ovs:leadsTo)."@en .

ovssh:CarrierShape a sh:NodeShape ;
    sh:targetClass ovs:Carrier ;
    sh:property [
        sh:path ovs:atStep ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ovssh:InAScheme ;
        sh:message "A carrier moves a document across the crossing at exactly one step, from a declared scheme."@en ;
    ] ;
    sh:property [
        sh:path ovs:carries ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A carrier carries exactly one document."@en ;
    ] ;
    sh:property [
        sh:path ovs:carrierKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( ovs:PlatformFlow ovs:Connector ovs:Sync ovs:MigrationRun ) ;
        sh:message "A carrier is one kind: ovs:PlatformFlow, ovs:Connector, ovs:Sync or ovs:MigrationRun. No carrier at all is the gap, not a kind."@en ;
    ] .
